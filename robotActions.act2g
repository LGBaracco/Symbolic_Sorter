use robot as knowledge.

% 3b. Modify the goTo action specification.
% The goTo action makes the agent move to a place (location) in the BW4T environment.
define goTo(Location) with
	% Checks that the agent is not stuck, that it is not going elsewhere, and that it is not already in the wanted location
	pre { not(state(collided)) , not(state(traveling)), not(in(Location))}
	post { true }

% Exercise 3c: add an extra condition to the precondition of the goToBlock action.
% Exercise 3a: add a specification for the goToBlock(Block) action.
define goToBlock(Block) with 
	% the agent can go to the block if it is in the room, it is not already traveling and it's not holding another block
	pre{ block(Block,_, Room), in(Room), not(state(traveling)), not(holding(_)) }
	post{ true }

% Exercise 3a: add a specification for the pickUp action.
define pickUp(Block) with
	% the goToBlock has been succesfully performed, and it is near the block and no other block is being held
	pre{ state(arrived), atBlock(Block), not(holding(_)) }
	post{ true }

% Exercise 3a: add a specification for the putDown action.
define putDown with
	% the agent has to be holding a block
	pre{ holding(_) }
	post{ true }